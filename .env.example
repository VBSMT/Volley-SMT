# Projet Supabase (région UE) — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de l'appli (lien magique)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Côté serveur uniquement (jamais NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys > secret / service_role
SUPABASE_SERVICE_ROLE_KEY=
# Notifications push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Appel horaire par pg_cron (même valeur que le secret « cron_secret » du Vault Supabase)
CRON_SECRET=
# Emails de secours via Brevo (identifiants SMTP)
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM="Volley SMT <adresse-validee-dans-brevo@exemple.fr>"
MAIL_FROM_ADDRESS=adresse-validee-dans-brevo@exemple.fr
